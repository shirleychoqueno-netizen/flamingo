# Public frontend URL only. Empty uses the existing deployed research API.
# For a fully local proxy, set this to http://localhost:8787 in .env.local.
VITE_API_BASE_URL=

# Optional CLI credentials. Prefer an existing Wrangler login for local deploys.
# Cloudflare Workers Builds supplies its own deployment authorization.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

