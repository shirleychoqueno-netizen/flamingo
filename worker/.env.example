# Variable-name inventory. Values are intentionally empty.
# Non-secret deployed defaults are in wrangler.toml; local defaults in wrangler.dev.toml.
# Never prefix a provider key with VITE_.
OPENAI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=
OPENAI_MODEL=
OPENAI_REQUIRE_PROMO_SMALL_GROUP=
OPENAI_PROMO_PROJECT_CONFIRMED=
OPENAI_BALANCE_CONFIRMED=
ENABLE_OPENAI=
ENABLE_RAG_GENERATION=
OPENAI_BILLING_APPROVED=
ENABLE_GROQ=
FREE_TIER_CONFIRMED=
GROQ_MODEL=
ENABLE_SEMANTIC_SEARCH=
RETRIEVAL_CORPUS_VERSION=

# Optional Wrangler CLI authentication, not application runtime secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# AI, NASA_VECTORS, IP_LIMITER and GLOBAL_LIMITER are bindings, not key strings.
